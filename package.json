{
  "name": "mail-agent-root",
  "private": true,
  "scripts": {
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "f": "npm run dev:frontend",
    "b": "npm run dev:backend",
    "dev": "npx -y concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start:prod --prefix backend",
    "start:frontend": "npm run preview --prefix frontend",
    "db:migrate": "npm run prisma migrate dev --prefix backend",
    "db:studio": "npx prisma studio --schema backend/prisma/schema.prisma"
  }
}
