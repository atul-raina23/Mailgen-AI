# Database Connection URL (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/jaip_db?schema=public"

# Secret key for JWT Token signing
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# Gemini API Key for email classification (obtain from Google AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Google Cloud Console credentials for Gmail API access
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
